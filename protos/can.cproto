# --- convention parsing ---

Enum_t NodeId = {
    Mcu = 0x01;
}

Enum_t Priority = {
    Normal = 0x00;
    Urgent = 0x01;
}

Byte StatusId = {
    status_id = 1;
}

# --- spl parsing ---
Byte Version = {..}
# --- <> ---

Byte FanError = {
    fan_0_error = 0
    fan_1_error = 1
}

# --- unconventional parsing ---

ByteCol CoProc = {
    status_id = StatusId
    fan_error = FanError 
}

# --- len - mem parsing ---
ID MockFrameId = {
    NodeId[3] | Priority[7]
}

# --- <> ---


frame MockFrame = {
    id = MockFrameId;
    coproc = CoProc;
}